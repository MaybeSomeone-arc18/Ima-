# Google Gemini API key, used by /api/chat and /api/summarize. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project used to persist the feed and cache AI summaries (optional -
# without these the app still runs, just re-scrapes from scratch on every
# restart and keeps summaries only in memory). Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Port for the Express server (optional, defaults to 3001)
PORT=3001

# Standard Node environment flag (optional)
NODE_ENV=development
