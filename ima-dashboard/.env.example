# Google Gemini API key(s), used by /api/chat, /api/summarize, and /api/ask
# (both the pgvector and naive retrieval modes - both embed articles/queries
# with Gemini directly). Get one at https://aistudio.google.com/apikey
#
# Optionally set GEMINI_API_KEYS instead (comma-separated) to pool multiple
# keys - ideally from separate Google Cloud projects, since keys under the
# same project share its quota. When a key hits a 429, calls automatically
# route to the next key in the pool that isn't currently backed off, instead
# of failing outright - see server/quota.js. GEMINI_API_KEY is still read as
# a single-key fallback if GEMINI_API_KEYS isn't set.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Supabase project used to persist the feed, cache AI summaries, and (via its
# pgvector extension) run the indexed semantic search behind /api/ask
# (optional - without these the app still runs, just re-scrapes from scratch
# on every restart, keeps summaries only in memory, and semantic search is
# unavailable). Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit project used by /api/livekit-token to mint room tokens for the Ask
# bar's mic button (optional - without these, voice mode is unavailable but
# typed Ask still works). Must match the credentials ima-voice-agent/.env
# uses to run the voice worker. For local dev against `livekit-server --dev`,
# use the defaults shown here.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Port for the Express server (optional, defaults to 3001)
PORT=3001
