# LiveKit room credentials. For local dev against `livekit-server --dev`,
# keep the defaults below. For LiveKit Cloud, use the values from your
# project settings - and set the matching LIVEKIT_URL/KEY/SECRET in
# ima-dashboard's own .env too, since that's what mints the room token the
# frontend uses to join.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Moss project - same credentials as ima-dashboard/.env. This agent loads the
# "ima-articles" index the Node ingestion pipeline already builds; it does
# not build or rebuild it.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=ima-articles

# Deepgram, used for STT (speech-to-text).
DEEPGRAM_API_KEY=

# OpenAI - required. Always used for TTS (gpt-4o-mini-tts, voice "ash", see
# build_tts() in agent.py). Also used as the LLM if GOOGLE_API_KEY below
# isn't set.
OPENAI_API_KEY=

# Gemini - optional. Set this to use the Gemini plugin for the LLM instead
# of OpenAI's gpt-4o (runs against the granted 100K Gemini token budget).
# TTS still uses OpenAI either way.
GOOGLE_API_KEY=
